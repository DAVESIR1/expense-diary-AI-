{
  "name": "smart-expence-income",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "npm run build",
    "build:android:debug": "npm run build && npx @capacitor/cli sync android && cd android && ./gradlew assembleDebug",
    "build:android:bundle": "npm run build && npx @capacitor/cli sync android && cd android && ./gradlew bundleRelease",
    "android:patch": "node ./scripts/patch-android.js",
    "android:patch-version": "node ./scripts/patch-android-version.js",
    "prepare:android:sign": "echo 'Create a `key.properties` file in the project root with your keystore info (see key.properties.sample).'",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.12",
    "tailwindcss": "^3.4.8",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
